{
  "manifest_version": 3,
  "name": "DOWNLOAD-AJA Integration",
  "version": "0.1.0",
  "description": "Kirim link dan unduhan Chrome ke DOWNLOAD-AJA melalui native messaging lokal.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Kirim ke DOWNLOAD-AJA"
  },
  "options_page": "options.html"
}

<Window x:Class="DownloadAja.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Aja"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF4F4F4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Tugas" />
            <MenuItem Header="Unduh" />
            <MenuItem Header="Lihat" />
            <MenuItem Header="Jadwal" />
            <MenuItem Header="Kategori" />
            <MenuItem Header="Pilihan" />
            <MenuItem Header="Bantuan" />
        </Menu>

        <Border Grid.Row="1" BorderBrush="#FFD1D1D1" BorderThickness="0,1,0,1" Background="#FFF8F8F8">
            <ToolBarTray Background="Transparent">
                <ToolBar Band="0" BandIndex="0" Background="Transparent" Padding="8,4">
                    <Button Width="82" Height="58" Margin="2" Content="Tambah URL" />
                    <Separator />
                    <Button Width="70" Height="58" Margin="2" Content="Mulai" />
                    <Button Width="70" Height="58" Margin="2" Content="Jeda" />
                    <Button Width="70" Height="58" Margin="2" Content="Hentikan" />
                    <Button Width="70" Height="58" Margin="2" Content="Hapus" />
                    <Separator />
                    <Button Width="78" Height="58" Margin="2" Content="Jadwal" />
                    <Button Width="112" Height="58" Margin="2" Content="Ambil dari Browser" />
                    <Separator />
                    <Button Width="70" Height="58" Margin="2" Content="Opsi" />
                    <Button Width="78" Height="58" Margin="2" Content="Bantuan" />
                </ToolBar>
            </ToolBarTray>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="6" BorderBrush="#FFC8C8C8" BorderThickness="1" Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kategori" FontWeight="SemiBold" Padding="8,6" Background="#FFF2F2F2" />
                    <ListBox BorderThickness="0" SelectedIndex="0">
                        <ListBoxItem Content="Semua Unduhan" Padding="8,5" />
                        <ListBoxItem Content="Selesai" Padding="8,5" />
                        <ListBoxItem Content="Belum Selesai" Padding="8,5" />
                        <ListBoxItem Content="Antrean" Padding="8,5" />
                        <Separator Margin="4" />
                        <ListBoxItem Content="Video" Padding="8,5" />
                        <ListBoxItem Content="Audio" Padding="8,5" />
                        <ListBoxItem Content="Dokumen" Padding="8,5" />
                        <ListBoxItem Content="Arsip" Padding="8,5" />
                        <ListBoxItem Content="Program" Padding="8,5" />
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFE2E2E2" />

            <DataGrid Grid.Column="2"
                      Margin="0,6,6,6"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama File" Width="2.5*" Binding="{Binding FileName}" />
                    <DataGridTextColumn Header="Ukuran" Width="0.8*" Binding="{Binding SizeText}" />
                    <DataGridTextColumn Header="Status" Width="1.2*" Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="Kecepatan" Width="1*" Binding="{Binding SpeedText}" />
                    <DataGridTextColumn Header="Sisa Waktu" Width="1*" Binding="{Binding EtaText}" />
                    <DataGridTextColumn Header="Tanggal" Width="1.25*" Binding="{Binding DateText}" />
                    <DataGridTextColumn Header="Folder" Width="1.5*" Binding="{Binding Folder}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TabControl Grid.Row="3" Margin="6,0,6,6">
            <TabItem Header="Detail Unduhan">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Nama File" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Status" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="Ukuran" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="Kecepatan" Margin="0,2" />
                    <TextBlock Grid.Row="4" Text="Sisa Waktu" Margin="0,2" />
                    <TextBlock Grid.Row="5" Text="Alamat" Margin="0,2" />
                    <TextBlock Grid.Row="6" Text="Folder" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="-" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="-" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="-" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="3" Text="-" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="4" Text="-" Margin="0,2" />
                    <TextBlock Grid.Column="1" Grid.Row="5" Text="-" Margin="0,2" Foreground="#FF0066CC" />
                    <TextBlock Grid.Column="1" Grid.Row="6" Text="-" Margin="0,2" />
                </Grid>
            </TabItem>
            <TabItem Header="Progress">
                <TextBlock Margin="12" Text="Belum ada unduhan aktif." Foreground="Gray" />
            </TabItem>
            <TabItem Header="Log">
                <TextBlock Margin="12" Text="Log runtime akan ditampilkan di sini pada tahap integrasi engine." Foreground="Gray" />
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="4">
            <StatusBarItem Content="Siap" />
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Unduhan aktif: 0   |   Total kecepatan: 0 B/det" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

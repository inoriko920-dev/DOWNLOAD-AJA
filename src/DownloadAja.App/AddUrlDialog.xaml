<Window x:Class="DownloadAja.App.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah URL"
        Width="650"
        Height="330"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,0,10,10" />
        <TextBox x:Name="UrlBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Height="28"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 LostFocus="UrlBox_OnLostFocus" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama file" VerticalAlignment="Center" Margin="0,0,10,10" />
        <TextBox x:Name="FileNameBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Height="28"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Simpan ke" VerticalAlignment="Center" Margin="0,0,10,10" />
        <TextBox x:Name="FolderBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="28"
                 Margin="0,0,8,10"
                 VerticalContentAlignment="Center" />
        <Button Grid.Row="2"
                Grid.Column="2"
                Height="28"
                MinWidth="82"
                Margin="0,0,0,10"
                Content="Pilih..."
                Click="BrowseButton_OnClick" />

        <CheckBox x:Name="StartQueueCheckBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,2,0,10"
                  IsChecked="True"
                  Content="Mulai antrean setelah ditambahkan" />

        <Border Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#FFF7F7F7"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                Padding="10"
                Margin="0,2,0,12">
            <TextBlock Foreground="#FF555555"
                       TextWrapping="Wrap"
                       Text="Baseline recovery R7 menerima URL HTTP/HTTPS. Nama file boleh dikosongkan agar diambil otomatis dari URL. Jika URL, file tujuan, atau file di disk duplikat, penambahan akan ditolak agar file tidak tertimpa." />
        </Border>

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="92" Height="30" Margin="0,0,8,0" Content="Tambah" IsDefault="True" Click="AddButton_OnClick" />
            <Button Width="92" Height="30" Content="Batal" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
